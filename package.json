    "proof:demo": "node scripts/proof-demo.mjs",
    "test:network": "node scripts/test-network.mjs",
    "network:init": "tsx scripts/midnight/init.mts",
    "network:status": "tsx scripts/midnight/status.mts",
    "network:dust": "tsx scripts/midnight/dust.mts",
    "network:deploy": "tsx scripts/midnight/deploy.mts",
    "network:attest": "tsx scripts/midnight/attest.mts",
    "network:verify": "tsx scripts/midnight/verify.mts",
    "network:probe": "tsx scripts/midnight/probe-indexer.mts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
